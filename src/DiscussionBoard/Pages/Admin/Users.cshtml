@page
@using DiscussionBoard.Authorization
@model DiscussionBoard.Pages.Admin.UsersModel

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>
    <h1>Manage Users</h1>

    @if (Model.Message != null)
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <form method="post">
        <div class="mb-3">
            <label asp-for="SelectedUserId" class="form-label">User</label>
            <select asp-for="SelectedUserId" class="form-select">
                <option value="">-- Select User --</option>
                @foreach (var user in Model.Users)
                {
                    <option value="@user.Id">@user.DisplayName (@user.Email)</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Select</button>
    </form>

    @if (Model.SelectedUser != null)
    {
        <form method="post" asp-page-handler="UpdateRole" class="mt-4">
            <input type="hidden" asp-for="SelectedUserId" id="RoleFormUserId" />
            <input type="hidden" asp-for="Role" value="@ApplicationRoles.Admin" />

            <p>
                <strong>@Model.SelectedUser.DisplayName</strong>
                (@Model.SelectedUser.Email)
            </p>

            @if (Model.IsAdmin)
            {
                <button type="submit" name="Operation" value="Remove" class="btn btn-danger">Remove from Admin</button>
            }
            else
            {
                <button type="submit" name="Operation" value="Add" class="btn btn-success">Add to Admin</button>
            }
        </form>
    }
</div>
</body>
</html>
