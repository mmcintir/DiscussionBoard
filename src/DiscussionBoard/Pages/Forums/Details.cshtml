@page "/Forum/{id}"
@using DiscussionBoard.Models
@model DiscussionBoard.Pages.DetailsModel

@{ ViewData["Title"] = "" ; }

@if (ViewData["Error"] != null)
{
    <p>@ViewData["Error"]</p>
}
else
{
    <h1>Forums</h1>
    @foreach (var thread in Model.Items)
    {
        <partial name="/Pages/Forums/_ThreadCard.cshtml" model="thread" />
    }
}

